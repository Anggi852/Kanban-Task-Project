# ─── Dev image: NestJS + Prisma with hot reload ──────────────────────────────
# Source code is bind-mounted from the host at runtime (see compose.dev.yml),
# so this image only needs the runtime + a warm node_modules cache.
FROM oven/bun:1-alpine

WORKDIR /app

# System deps: openssl for Prisma engines, tini for clean signal handling
# (so Ctrl-C from `docker compose up` actually stops the watcher).
RUN apk add --no-cache openssl tini

# Prime node_modules inside the image so first `up` is fast. The compose file
# mounts an anonymous volume over /app/node_modules to keep this cache from
# being clobbered by the host bind-mount.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Prisma schema is needed at container start for `prisma generate` (the
# generated client lives at src/generated/prisma — see prisma.config.ts).
COPY prisma ./prisma
COPY prisma.config.ts ./

ENV NODE_ENV=development \
    PORT=8000 \
    CHOKIDAR_USEPOLLING=true \
    CHOKIDAR_INTERVAL=500

EXPOSE 8000 9229

# tini reaps zombies and forwards SIGTERM/SIGINT to bun.
ENTRYPOINT ["/sbin/tini", "--"]

# Regenerate the Prisma client against the currently mounted schema, apply
# any pending migrations, then start NestJS in watch mode.
CMD ["sh", "-c", "bunx prisma generate && bunx prisma migrate deploy && bun run start:dev"]

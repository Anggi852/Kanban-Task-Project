# Force LF on files that run inside Linux containers, regardless of host OS.
# Without this, Windows checkouts can leave CRLF in shell scripts, which
# breaks `#!/bin/sh` in Alpine with "bad interpreter: No such file or directory".
*.sh           text eol=lf
entrypoint.sh  text eol=lf
*.conf         text eol=lf
Dockerfile     text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
